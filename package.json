{
  "name": "voice-widget-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "description": "Voice widget backend with OpenAI Whisper and GPT-4 for real estate assistant",
  "author": "Your Name",
  "license": "ISC",
  "keywords": [
    "voice",
    "ai",
    "whisper",
    "gpt-4",
    "real-estate",
    "transcription"
  ],
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "xml:sync": "IMPORT_CLIENT_ID=${IMPORT_CLIENT_ID:-estyle} XML_SYNC_DEACTIVATE=1 XML_SYNC_MIN_COUNT=${XML_SYNC_MIN_COUNT:-500} node scripts/importFromXml.js",
    "xml:sync:dry-run": "IMPORT_CLIENT_ID=${IMPORT_CLIENT_ID:-estyle} XML_IMPORT_DRY_RUN=1 XML_SYNC_DEACTIVATE=1 XML_SYNC_MIN_COUNT=${XML_SYNC_MIN_COUNT:-500} node scripts/importFromXml.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "csv-parse": "^6.1.0",
    "dotenv": "^17.2.1",
    "express": "^4.21.2",
    "mysql2": "^3.14.2",
    "multer": "^2.0.2",
    "openai": "^5.10.2",
    "pg": "^8.16.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
